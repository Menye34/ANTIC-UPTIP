# Copy to .env locally; never commit populated values.
UPTIP_DATABASE_URL=postgresql+psycopg://uptip:<local-database-password>@127.0.0.1:5432/uptip
UPTIP_RATE_KEY=<generate-at-least-32-random-characters>
UPTIP_ENVIRONMENT=development
UPTIP_PUBLIC_ORIGIN=http://localhost:5173
# HTTP loopback development only; production requires true + HTTPS.
UPTIP_COOKIE_SECURE=false
UPTIP_SESSION_SECONDS=1800
UPTIP_RATE_WINDOW_SECONDS=900
UPTIP_IP_LIMIT=30
UPTIP_USERNAME_LIMIT=10
